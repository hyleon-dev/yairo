{
  "name": "yairo",
  "version": "0.0.1",
  "description": "Yet Another iRacing Overlay",
  "main": "out/main/index.js",
  "author": "hyLeon",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "cross-env IRSDK_MOCK=1 electron-vite dev",
    "dev:document": "cross-env ANONYMIZE_DRIVER_NAMES=1 OVERLAY_SCREENSHOTS=1 electron-vite dev",
    "dev:debug": "electron-vite dev --inspect --sourcemap",
    "dump:iracing": "tsx scripts/dump-iracing-data.js",
    "dump:iracing-raw": "node scripts/dump-iracing-raw.js",
    "dump:lmu": "node scripts/dump-lmu-data.js",
    "lmu:gen-offsets": "scripts\\lmu-offsets\\gen-lmu-offsets.bat",
    "iracing:build-trackmaps": "node scripts/build-trackmap-registry.js",
    "general:build-manufacturer-logos": "node scripts/build-manufacturer-logos.js",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "js-yaml": "^4.3.2",
    "koffi": "^3.3.2",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-colorful": "^5.8.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "de.hyleon.yairo",
    "productName": "YAiRO",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "resources/icon.png"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "yairo-${version}.${ext}"
    }
  }
}
